{
    "id": "survey_workflow_v1",
    "name": "Customer Satisfaction Survey",
    "description": "Comprehensive customer satisfaction survey with rating questions and feedback collection",
    "version": "1.0.0",
    "type": "survey",
    "settings": {
        "timeout_minutes": 15,
        "max_retries": 1,
        "enable_parallel_steps": false,
        "require_all_steps": false
    },
    "steps": [
        {
            "id": "introduction",
            "type": "introduction",
            "title": "Survey Introduction",
            "description": "Introduction to the customer satisfaction survey",
            "order": 1,
            "required": true,
            "instructions": "Welcome the customer and explain the survey purpose.",
            "data": {
                "welcome_message": "Hello! Thank you for taking the time to participate in our customer satisfaction survey. Your feedback is valuable to us and will help us improve our services. This survey will take about 5-10 minutes to complete."
            }
        },
        {
            "id": "overall_satisfaction",
            "type": "rating_question",
            "title": "Overall Satisfaction",
            "description": "Rate your overall satisfaction with our service",
            "order": 2,
            "required": true,
            "instructions": "Ask for overall satisfaction rating.",
            "data": {
                "question": "How satisfied are you with our service overall?",
                "rating_scale": {
                    "type": "likert_scale",
                    "min_value": 1,
                    "max_value": 5,
                    "labels": [
                        "Very Dissatisfied",
                        "Dissatisfied",
                        "Neutral",
                        "Satisfied",
                        "Very Satisfied"
                    ]
                },
                "required": true
            }
        },
        {
            "id": "service_quality",
            "type": "rating_question",
            "title": "Service Quality",
            "description": "Rate the quality of service received",
            "order": 3,
            "required": true,
            "instructions": "Ask for service quality rating.",
            "data": {
                "question": "How would you rate the quality of service you received?",
                "rating_scale": {
                    "type": "likert_scale",
                    "min_value": 1,
                    "max_value": 5,
                    "labels": [
                        "Poor",
                        "Fair",
                        "Good",
                        "Very Good",
                        "Excellent"
                    ]
                },
                "required": true
            }
        },
        {
            "id": "recommendation_likelihood",
            "type": "rating_question",
            "title": "Net Promoter Score",
            "description": "Likelihood to recommend our service",
            "order": 4,
            "required": true,
            "instructions": "Ask for recommendation likelihood (NPS question).",
            "data": {
                "question": "How likely are you to recommend our service to a friend or colleague?",
                "rating_scale": {
                    "type": "nps_scale",
                    "min_value": 0,
                    "max_value": 10,
                    "labels": [
                        "Not at all likely",
                        "Extremely likely"
                    ]
                },
                "required": true,
                "nps_calculation": true
            }
        },
        {
            "id": "specific_ratings",
            "type": "multiple_rating",
            "title": "Specific Service Aspects",
            "description": "Rate specific aspects of the service",
            "order": 5,
            "required": true,
            "instructions": "Ask for ratings on specific service aspects.",
            "data": {
                "question": "Please rate the following aspects of our service:",
                "aspects": [
                    {
                        "id": "response_time",
                        "label": "Response Time",
                        "description": "How quickly we responded to your needs"
                    },
                    {
                        "id": "staff_knowledge",
                        "label": "Staff Knowledge",
                        "description": "Knowledge and expertise of our staff"
                    },
                    {
                        "id": "communication",
                        "label": "Communication",
                        "description": "Clarity and effectiveness of communication"
                    },
                    {
                        "id": "problem_resolution",
                        "label": "Problem Resolution",
                        "description": "How well we resolved any issues"
                    }
                ],
                "rating_scale": {
                    "type": "likert_scale",
                    "min_value": 1,
                    "max_value": 5,
                    "labels": [
                        "Poor",
                        "Fair",
                        "Good",
                        "Very Good",
                        "Excellent"
                    ]
                }
            }
        },
        {
            "id": "improvement_suggestions",
            "type": "open_ended",
            "title": "Improvement Suggestions",
            "description": "Collect suggestions for improvement",
            "order": 6,
            "required": false,
            "instructions": "Ask for suggestions on how to improve the service.",
            "data": {
                "question": "What suggestions do you have for improving our service?",
                "input_type": "text_area",
                "max_length": 500,
                "placeholder": "Please share any suggestions or ideas for improvement..."
            }
        },
        {
            "id": "additional_feedback",
            "type": "open_ended",
            "title": "Additional Feedback",
            "description": "Collect any additional feedback",
            "order": 7,
            "required": false,
            "instructions": "Ask for any additional feedback or comments.",
            "data": {
                "question": "Is there anything else you would like to share about your experience?",
                "input_type": "text_area",
                "max_length": 1000,
                "placeholder": "Please share any additional comments or feedback..."
            }
        },
        {
            "id": "demographic_info",
            "type": "demographic_collection",
            "title": "Demographic Information",
            "description": "Collect optional demographic information",
            "order": 8,
            "required": false,
            "instructions": "Ask for optional demographic information for analysis.",
            "data": {
                "questions": [
                    {
                        "id": "age_range",
                        "question": "What is your age range?",
                        "type": "multiple_choice",
                        "options": [
                            "18-24",
                            "25-34",
                            "35-44",
                            "45-54",
                            "55-64",
                            "65+",
                            "Prefer not to say"
                        ],
                        "required": false
                    },
                    {
                        "id": "usage_frequency",
                        "question": "How often do you use our service?",
                        "type": "multiple_choice",
                        "options": [
                            "Daily",
                            "Weekly",
                            "Monthly",
                            "Occasionally",
                            "First time"
                        ],
                        "required": false
                    }
                ]
            }
        },
        {
            "id": "completion",
            "type": "completion",
            "title": "Survey Complete",
            "description": "Survey completed successfully",
            "order": 9,
            "required": true,
            "instructions": "Thank the customer for completing the survey.",
            "data": {
                "completion_message": "Thank you for completing our customer satisfaction survey! Your feedback is very important to us and will help us improve our services. We appreciate your time and input.",
                "next_steps": [
                    "Your responses have been recorded",
                    "We will use your feedback to improve our services",
                    "You may receive a follow-up if you provided contact information"
                ]
            }
        }
    ],
    "metadata": {
        "created_at": "2024-01-01T00:00:00Z",
        "updated_at": "2024-01-01T00:00:00Z",
        "author": "Enterprise Survey System",
        "tags": [
            "survey",
            "customer_satisfaction",
            "feedback",
            "nps"
        ]
    }
}