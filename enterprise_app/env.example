# Application Configuration
APP_NAME="Enterprise AI Video KYC System"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database Configuration
DATABASE_URL=mysql+aiomysql://your_mysql_username:your_mysql_password@localhost:3306/kyc_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20


# VideoSDK Configuration
VIDEOSDK_API_KEY=your_videosdk_api_key
VIDEOSDK_API_SECRET=your_videosdk_secret
VIDEOSDK_BASE_URL=https://api.videosdk.live/

# AI Provider Configuration
# Sarvam AI
SARVAMAI_API_KEY=your_sarvamai_api_key

# Google AI
GOOGLE_API_KEY=your_google_api_key

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=logs/app.log

# Security Configuration
SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS Configuration
CORS_ORIGINS=["http://localhost:4200", "http://localhost:3000", "http://127.0.0.1:4200", "http://127.0.0.1:3000", "https://yourdomain.com"]
CORS_CREDENTIALS=true

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# Session Configuration
SESSION_TIMEOUT_MINUTES=60
MAX_CONCURRENT_SESSIONS=100

# File Upload Configuration
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=["image/jpeg", "image/png", "application/pdf"]

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090

# Wav2Lip Plugin Configuration
WAV2LIP_ENABLED=true
WAV2LIP_URL=http://35.207.229.235:8001
WAV2LIP_WEBSOCKET_URL=ws://35.207.229.235:8001/ws

# TTS Configuration for Avatar (Ultra-Low Latency)
TTS_PACE=1.5
TTS_PITCH=0.0
TTS_LOUDNESS=1.2
