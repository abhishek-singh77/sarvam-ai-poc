                "order": 2,
                "scale": {
                    "type": "numeric",
                    "min": 1,
                    "max": 10,
                    "labels": {
                        "1": "Very Dissatisfied",
                        "5": "Neutral",
                        "10": "Very Satisfied"
                    }
                }
            },
            {
                "id": "service_quality",
                "title": "Service Quality Assessment",
                "type": "rating",
