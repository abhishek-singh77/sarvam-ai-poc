                "required": true,
                "order": 4,
                "scale": {
                    "type": "numeric",
                    "min": 0,
                    "max": 10,
                    "labels": {
                        "0": "Not at all likely",
                        "5": "Neutral",
                        "10": "Extremely likely"
                    }
                }
            },
            {
                "id": "feedback",
                "title": "Open Feedback",
                "type": "text_input",
                "description": "Please provide any additional feedback or suggestions",
                "required": false,
                "order": 5,
