{
    "agent": {
        "agent_id": "kyc_agent_001",
        "agent_type": "kyc",
        "instructions": "You are a professional KYC assistant. Help users complete their identity verification process. Be friendly, patient, and thorough in collecting required information.",
        "language": "en",
        "model": "gpt-4",
        "temperature": 0.7,
        "max_tokens": 1000,
        "system_prompt": "You are a KYC (Know Your Customer) verification assistant. Your role is to guide users through the identity verification process in a professional and friendly manner. Always ask for required documents and information clearly, and explain why each piece of information is needed.",
        "metadata": {
            "version": "1.0.0",
            "category": "verification",
            "compliance": [
                "KYC",
                "AML"
            ]
        }
    },
    "workflow": {
        "workflow_id": "kyc_workflow_001",
        "workflow_type": "kyc",
        "name": "KYC Verification Process",
        "description": "Complete KYC verification process including document collection and identity verification",
        "version": "1.0.0",
        "steps": [
            {
                "id": "introduction",
                "title": "Welcome & Introduction",
                "type": "introduction",
                "description": "Welcome the user and explain the KYC process",
                "required": true,
                "order": 1
            },
            {
                "id": "personal_info",
                "title": "Personal Information Collection",
                "type": "data_collection",
                "description": "Collect basic personal information",
                "required": true,
                "order": 2,
                "fields": [
                    "full_name",
                    "date_of_birth",
                    "address",
                    "phone_number",
                    "email"
                ]
            },
            {
                "id": "document_upload",
                "title": "Document Verification",
                "type": "document_verification",
                "description": "Upload and verify identity documents",
                "required": true,
                "order": 3,
                "documents": [
                    "government_id",
                    "proof_of_address"
                ]
            },
            {
                "id": "biometric_verification",
                "title": "Biometric Verification",
                "type": "biometric",
                "description": "Capture and verify biometric data",
                "required": true,
                "order": 4,
                "biometrics": [
                    "face_verification",
                    "liveness_check"
                ]
            },
            {
                "id": "completion",
                "title": "Process Completion",
                "type": "completion",
                "description": "Complete the KYC process and provide next steps",
                "required": true,
                "order": 5
            }
        ],
        "metadata": {
            "estimated_duration": "10-15 minutes",
            "difficulty": "medium",
            "compliance_standards": [
                "KYC",
                "AML",
                "GDPR"
            ]
        }
    },
    "session": {
        "timeout_minutes": 30,
        "max_retries": 3,
        "auto_save": true,
        "notifications": {
            "email": true,
            "sms": false,
            "push": true
        }
    }
